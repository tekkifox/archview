# ArchView configuration example. Copy to stack.env (or .env) and edit.

# --- Server ---------------------------------------------------------------
PORT="8080"

# --- Docker / host access -------------------------------------------------
DOCKER_HOST=tcp://socket-proxy:2375
DOCKER_API_VERSION="v1.44"
DOCKER_SOCKET=/var/run/docker.sock
HOST_PROC=/host/proc
HOST_SYS=/host/sys
HOST_ROOT=/host/root

# --- CORS -----------------------------------------------------------------
# Comma-separated exact origins allowed to call the API from a browser, e.g.
# "https://dashboard.example.com,https://admin.example.com".
# Leave empty for same-origin only (secure default).
CORS_ALLOWED_ORIGINS=

# --- Authentication -------------------------------------------------------
# "none", "oidc" or "oauth2". Leave empty to infer from the OAUTH_* values;
# when nothing is configured authentication is disabled and a warning is logged.
# For local evaluation only, AUTH_MODE=none leaves the API unauthenticated.
AUTH_MODE=oidc

# OpenID Connect (Google, Entra ID, Okta, Auth0, Keycloak, ...)
OAUTH_ISSUER=https://accounts.example.com
OAUTH_CLIENT_ID=archview
OAUTH_CLIENT_SECRET=replace-me
# Must exactly match the registered callback URL.
OAUTH_REDIRECT_URL=https://archview.rossmoney.me/auth/callback
OAUTH_SCOPES=openid profile email

# Restrict who may use the API. Leave both empty to allow any identity that
# the provider authenticates. Domains also allow subdomains.
OAUTH_ALLOWED_EMAILS=
OAUTH_ALLOWED_DOMAINS=example.com

# Where the browser lands after login/logout.
OAUTH_POST_LOGIN_REDIRECT=/
# OAUTH_POST_LOGOUT_REDIRECT=https://dashboard.example.com
# Additional absolute redirect targets allowed by OAUTH_POST_LOGIN_REDIRECT /
# the ?redirect= parameter, comma-separated.
# OAUTH_ALLOWED_REDIRECT_URLS=https://dashboard.example.com,https://admin.example.com

# Session cookie. SESSION_SECRET must be at least 32 bytes and must be identical
# on every replica because sessions are stateless.
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL=8h
SESSION_COOKIE_NAME=archview_session
SESSION_COOKIE_SECURE=true
# lax (default), strict, or none. Use none only with Secure=true and CORS.
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=

# Machine-to-machine API keys, comma-separated. Optional "label:key" form keeps
# the key out of logs/telemetry while identifying the caller.
API_KEYS=
# API_KEYS=monitoring:ff9a1c1a0a5c4f67b0b8b1f6d0e2c111,ci:2d3f5a7c9e1b4d6f8a0c2e4b6d8f0a1c

# Bearer JWT audience(s) accepted by the API. Defaults to OAUTH_CLIENT_ID.
# OAUTH_AUDIENCES=archview,https://api.example.com

# --- Non-OIDC OAuth2 provider (for example GitHub) ------------------------
# AUTH_MODE=oauth2
# OAUTH_AUTHORIZATION_URL=https://github.com/login/oauth/authorize
# OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
# OAUTH_USERINFO_URL=https://api.github.com/user
# OAUTH_EMAILS_URL=https://api.github.com/user/emails
# OAUTH_SCOPES=read:user user:email
# OAUTH_SUBJECT_CLAIM=id
# OAUTH_NAME_CLAIM=login

# --- Reverse proxy / development -----------------------------------------
# Set to true only when ArchView runs behind a trusted proxy that sets
# X-Forwarded-Proto/Host.
TRUST_PROXY_HEADERS=false
# Allow http:// identity provider endpoints (local development only).
OAUTH_ALLOW_INSECURE_HTTP=false

# --- socket-proxy settings (docker-compose only) --------------------------
CONTAINERS="1"
IMAGES="1"
INFO="1"
PING="1"
POST="0"
VERSION="1"
LOG_LEVEL=info
